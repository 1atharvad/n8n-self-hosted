# ─────────────────────────────────────────────────────────────────────────────
# .env.example
# Copy to .env and fill in all values marked REQUIRED.
# Values marked AUTO are appended by Ansible on every server deploy
# (from ansible/playbooks/group_vars/all.yml) — you still need them locally.
# ─────────────────────────────────────────────────────────────────────────────


# ── Admin Panel ───────────────────────────────────────────────────────────────

# Secret used to sign JWT tokens. Any long random string.
# Generate with: openssl rand -hex 32
JWT_SECRET=                          # REQUIRED

# Admin panel login credentials
LOGS_ADMIN_USERNAME=admin            # optional — default: admin
LOGS_ADMIN_PASSWORD=                 # REQUIRED

# JWT token expiry in hours
JWT_EXPIRE_HOURS=24                  # optional — default: 24


# ── PostgreSQL ────────────────────────────────────────────────────────────────

POSTGRES_USER=                       # REQUIRED
POSTGRES_PASSWORD=                   # REQUIRED
POSTGRES_DB=                         # REQUIRED
POSTGRES_PORT=5432                   # optional — default: 5432
POSTGRES_HOST=postgres               # AUTO (set by Ansible)


# ── MinIO (object storage) ────────────────────────────────────────────────────

MINIO_ROOT_USER=                     # REQUIRED
MINIO_ROOT_PASSWORD=                 # REQUIRED
MINIO_BUCKET_NAME=                   # REQUIRED
MINIO_ENDPOINT=http://rustfs:9000     # AUTO (set by Ansible)


# ── n8n ───────────────────────────────────────────────────────────────────────

# Encryption key for n8n credentials. Any long random string.
# Generate with: openssl rand -hex 32
# WARNING: Changing this after first run will break all saved credentials.
N8N_ENCRYPTION_KEY=                  # REQUIRED

# Basic auth for accessing the n8n UI
N8N_BASIC_AUTH_USER=                 # REQUIRED
N8N_BASIC_AUTH_PASSWORD=             # REQUIRED

# n8n API key — generate from n8n UI after first login: Settings → API
N8N_API_KEY=                         # optional — add after first login

# Public URL where n8n is accessible
N8N_EDITOR_BASE_URL=                 # REQUIRED  e.g. https://n8n.example.com
WEBHOOK_TUNNEL_URL=                  # REQUIRED  e.g. https://n8n.example.com
VUE_APP_URL_BASE_API=                # REQUIRED  base URL for admin frontend API  e.g. https://n8n.example.com

# n8n internals — AUTO (set by Ansible)
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_LISTEN_ADDRESS=0.0.0.0
N8N_SECURE_COOKIE=false
N8N_TRUST_PROXY=1
N8N_PROXY_HOPS=2
N8N_BASIC_AUTH_ACTIVE=true
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_BASE_URL=http://n8n:5678

# Execution tuning — AUTO (set by Ansible)
EXECUTIONS_TIMEOUT=10800
EXECUTIONS_DATA_MAX_AGE=168
QUEUE_BULL_REDIS_TIMEOUT_THRESHOLD=3900000
QUEUE_BULL_MAX_STALLED_COUNT=10
QUEUE_BULL_STALLED_INTERVAL=300000


# ── Media API (FastAPI) ───────────────────────────────────────────────────────

# API key required on all media API requests (X-API-Key header)
API_KEY=                             # REQUIRED

# FastAPI SQLAdmin panel credentials
ADMIN_USERNAME=admin                 # optional — default: admin
ADMIN_PASSWORD=                      # REQUIRED
ADMIN_SECRET_KEY=                    # REQUIRED  any long random string


# ── Internal Services ─────────────────────────────────────────────────────────

# Shared secret for service-to-service calls (e.g. audit log ingestion)
INTERNAL_SECRET=                     # REQUIRED  any long random string

# Internal service URLs — AUTO (set by Ansible)
ADMIN_API_URL=http://admin-api:8080
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres


# ── Redis ─────────────────────────────────────────────────────────────────────

# AUTO (set by Ansible)
REDIS_HOST=redis
REDIS_PORT=6379


# ── Worker Monitor ────────────────────────────────────────────────────────────

SERVER_ID=main                       # optional — identifier shown in dashboard
WORKER_MONITOR_POLL_SEC=30           # optional — seconds between snapshots
CPU_GATE_THRESHOLD=35                # optional — CPU % gate for API requests


# ── Misc ──────────────────────────────────────────────────────────────────────

GENERIC_TIMEZONE=UTC                 # optional — e.g. America/New_York
NODE_OPTIONS=--max-old-space-size=4096  # AUTO (set by Ansible)
